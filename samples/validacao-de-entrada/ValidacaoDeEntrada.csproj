<Project Sdk="Microsoft.NET.Sdk">

  <!-- Exemplo: validação de entrada com o contrato no DI, XSS e SQL injection do jeito errado e do certo. -->
  <!-- Para rodar: dotnet run (dentro desta pasta). -->

  <PropertyGroup>
    <AssemblyName>ValidacaoDeEntrada</AssemblyName>
    <RootNamespace>ValidacaoDeEntrada</RootNamespace>
    <!-- A normalização Unicode (NFKC) precisa dos dados de globalização: este exemplo desliga o modo invariante
         que o resto do repositório usa. A saída não depende de cultura (nenhum número formatado). -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Enneal.Algoritmos.ValidacaoEntrada/Enneal.Algoritmos.ValidacaoEntrada.csproj" />
  </ItemGroup>

</Project>
