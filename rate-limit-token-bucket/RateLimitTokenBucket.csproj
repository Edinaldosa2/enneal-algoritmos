<Project Sdk="Microsoft.NET.Sdk">

  <!-- Rate limit x DDoS: token bucket por IP (simulação didática). -->
  <!-- Projeto console .NET 8. Para rodar: dotnet run (dentro desta pasta). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RateLimitTokenBucket</AssemblyName>
    <RootNamespace>RateLimitTokenBucket</RootNamespace>
  </PropertyGroup>

</Project>
