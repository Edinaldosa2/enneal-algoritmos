<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testes da validação de entrada (xUnit), num projeto separado porque a normalização Unicode (NFKC)
    precisa dos dados de globalização: aqui o modo invariante do resto do repositório fica desligado.
    Para rodar, na raiz do repositório:  dotnet test
  -->

  <PropertyGroup>
    <RootNamespace>Enneal.Algoritmos.ValidacaoEntrada.Tests</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Enneal.Algoritmos.ValidacaoEntrada/Enneal.Algoritmos.ValidacaoEntrada.csproj" />
    <ProjectReference Include="../../samples/validacao-de-entrada/ValidacaoDeEntrada.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../samples/validacao-de-entrada/saida-esperada.txt" Link="saida-esperada.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
